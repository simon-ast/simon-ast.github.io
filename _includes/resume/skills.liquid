<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item skill-group">
      <span class="badge font-weight-bold danger-color-dark text-uppercase skill-category">
        {{ content.name }}
      </span>
      <span class="skill-items">
        {% for item in content.keywords %}
          {{ item }}{% unless forloop.last %} <strong>|</strong> {% endunless %}
        {% endfor %}
      </span>
    </li>
  {% endfor %}
</ul>
